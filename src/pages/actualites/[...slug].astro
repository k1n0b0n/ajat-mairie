---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { dateDe, dateIso, formaterDate } from '../../lib/dates';
import { resoudreImage } from '../../lib/images';
import { getPublies } from '../../lib/published';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const actualites = await getPublies('actualites');
  return actualites.map((actualite) => ({ params: { slug: actualite.id }, props: { actualite } }));
}

const { actualite } = Astro.props;
const { Content } = await render(actualite);
const date = dateDe(actualite.data);
const { cover } = actualite.data;
---
<Base titre={actualite.data.title} description={actualite.data.summary}>
  <article class="article">
    {date && <p class="date article-date"><time class="chiffres" datetime={dateIso(date)}>{formaterDate(date)}</time></p>}
    <div class="article-corps">
      <h1>{actualite.data.title}</h1>
      {cover && <Image src={resoudreImage(cover.image)} alt={cover.alt} widths={[400, 800]} sizes="(min-width: 48rem) 46rem, 100vw" />}
      <Content />
    </div>
  </article>
  <p><a href={url('/actualites/')}>← Toutes les actualités</a></p>
</Base>
