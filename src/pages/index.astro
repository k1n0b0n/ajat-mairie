---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AlaUne from '../components/AlaUne.astro';
import DansLaCommune from '../components/DansLaCommune.astro';
import Hero from '../components/Hero.astro';
import LaMairie from '../components/LaMairie.astro';
import { url } from '../lib/url';

const village = (await getEntry('accueil', 'accueil'))?.data.village ?? '';
---
<Base titre="Mairie d'Ajat" large>
  <Hero slot="pleine-largeur" />
  <div class="zones">
    <LaMairie />
    <AlaUne />
  </div>
  <section class="village" aria-labelledby="titre-village">
    <h2 id="titre-village">Le village</h2>
    <p>{village}</p>
    <p><a href={url('/decouvrir/')}>Découvrir Ajat</a></p>
  </section>
  <DansLaCommune />
</Base>
