---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Hours from '../components/Hours.astro';
import Illustration from '../components/Illustration.astro';

const visuel = (await getEntry('visuels', 'mairie'))?.data;
---
<Base titre="La mairie : horaires et accès" description="Horaires d'ouverture, téléphone, adresse et accès à la mairie d'Ajat." large>
  <h1>La mairie</h1>
  {visuel && <Illustration sizes="(min-width: 80rem) 72rem, 100vw" image={visuel.image} alt={visuel.alt} credit={visuel.credit} />}
  <div class="zones zones-mairie">
    <ContactBlock />
    <Hours />
  </div>
</Base>
