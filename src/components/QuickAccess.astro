---
import { url } from '../lib/url';

// Raccourcis provisoires de l'accueil (supprimés à la passe « mise en page ») : sans icône de décor.
const acces = [
  { libelle: 'Horaires', href: '#horaires' },
  { libelle: 'Actualités', href: url('/actualites/') },
  { libelle: 'Salle des fêtes', href: url('/salle-des-fetes/') },
];
---
<nav class="tuiles" aria-label="Accès rapides">
  <ul>
    {acces.map((a) => (
      <li><a href={a.href}>{a.libelle}</a></li>
    ))}
  </ul>
</nav>
